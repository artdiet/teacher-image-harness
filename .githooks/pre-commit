#!/usr/bin/env bash
# Blocks commits that contain secrets. Enable once per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); refusing to commit unscanned." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --verbose --no-banner
