# Local settings. Copy to .env (gitignored), or run scripts/setup_env.sh, which
# also generates the token. Never commit .env.

# ---- image server (native macOS process, see image-server/) ----
# Loopback by default: the Open WebUI container reaches it at
# http://host.docker.internal:7865 without exposing it to your network.
IMAGE_SERVER_HOST=127.0.0.1
IMAGE_SERVER_PORT=7865

# Shared secret; the Open WebUI function sends it as "Authorization: Bearer <token>".
IMAGE_SERVER_TOKEN=

# ---- LAN mode, for the Teach Image extension on other computers (docs/MCP.md) ----
# scripts/enable_lan.sh sets these three (and `scripts/enable_lan.sh off` undoes it):
#   IMAGE_SERVER_HOST=0.0.0.0
#   IMAGE_SERVER_ALLOW_REMOTE=true
#   IMAGE_SERVER_ALLOWED_HOSTS=127.0.0.1,localhost,host.docker.internal,<mac-name>.local,<mac-ip>
# Only answer clients on private networks (RFC 1918, link-local, CGNAT, loopback).
IMAGE_SERVER_PRIVATE_CLIENTS_ONLY=true
# Per-device tokens (hashes only) from scripts/client_tokens.sh. Default: <data dir>/client_tokens.json
# IMAGE_SERVER_CLIENT_TOKENS_FILE=
# Most pictures per job, and the largest upload accepted.
IMAGE_SERVER_MAX_N=4
IMAGE_SERVER_MAX_UPLOAD_BYTES=20971520

# Pictures (with JSON sidecars), references, job records and device tokens live
# here, outside the repo. SAVE_OUTPUTS=false stops keeping Open WebUI's pictures;
# the job API always keeps its pictures (clients fetch them by id).
IMAGE_SERVER_DATA_DIR="~/Library/Application Support/teacher-image-harness"
IMAGE_SERVER_SAVE_OUTPUTS=true

# Models: flux2-klein-4b (text-to-image + editing with up to 4 reference images)
# and z-image-turbo (text-to-image only). Both Apache-2.0.
IMAGE_SERVER_DEFAULT_MODEL=flux2-klein-4b
IMAGE_SERVER_EDIT_MODEL=flux2-klein-4b
# qwen-image-2.1-turbo is under the Qwen Research License (research/evaluation only).
IMAGE_SERVER_ENABLE_RESEARCH_MODELS=false

# Free memory for Ollama: unload the image model after this many idle seconds,
# and ask Ollama to unload its chat models before each image job.
IMAGE_SERVER_IDLE_UNLOAD_SECONDS=600
# After that idle unload, restart as a fresh, small process (launchd brings it back).
IMAGE_SERVER_RESTART_WHEN_IDLE=true
IMAGE_SERVER_FREE_OLLAMA=true
IMAGE_SERVER_OLLAMA_URL=http://127.0.0.1:11434

# Where the model weights live. Set it here (not only in your shell) so the
# launchd server and scripts/download_models.sh agree. Default: ~/.cache/huggingface
# HF_HOME="/Volumes/External/huggingface"

# ---- Open WebUI (scripts/install_openwebui.sh) ----
# Name shown in Open WebUI's model list. Kept here, not in the code, so a
# personal name never lands in the public repo.
OWUI_MODEL_NAME=TeachImageGPT
# Who can use the model (the first install grants every existing non-admin account):
#   blank = leave access as set in Open WebUI (Admin > Settings > Models)
#   1     = every account, including ones added later
#   0     = remove "every account" access on each install
# Re-run the installer with OWUI_GRANT_ALL=1 to add accounts created since.
OWUI_PUBLIC=
